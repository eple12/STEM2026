# Virtualenv -- recreated from requirements.txt, never committed.
.venv312/
.vscode/

__pycache__/
*.pyc

# Generated at build time by the Blender kit -> .bam pipeline.
ai_sw/assets/circuit_kit/obj/
ai_sw/assets/blender_f1/obj/

# Iteration screenshots and training logs.
ai_sw/car_preview/
ai_sw/selftest.png
*.log
*.err

# Supplied fp04rb source: a 500 MB .blend plus its texture and shadow maps,
# 1.06 GB in all. It is raw input to tools/build_f1_asset.py, which bakes the
# rb_* car -- a fallback the game does not currently use -- and git cannot
# shed a file that size once it is in the history. Keep it out of the repo and
# alongside it instead.
ai_sw/assets/f1_car_model/
# ...and the car it bakes, 19 MB and regenerable from the above.
ai_sw/assets/models/f1/rb_*.bam

# Blender build artefacts: regenerated by blender/*.py.
blender/*.blend
blender/preview*.png
blender/kit_sheet.png
blender/closeup_*.png
blender/*.blend1

# EMNIST source archives (587 MB) -- public data, re-downloadable from
# the NIST/EMNIST distribution. The notebooks in lowercase_letters_extension/
# read these; the trained models next to them are what is worth keeping.
gzip/

# Claude Code's own project notes. Delete this line to version them.
memory/

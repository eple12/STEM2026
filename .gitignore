# Virtualenv -- recreated from requirements.txt, never committed.
.venv312/
.vscode/

__pycache__/
*.pyc

# Generated at build time by the Blender kit -> .bam pipeline.
ai_sw/assets/circuit_kit/obj/
ai_sw/assets/blender_f1/obj/

# Iteration screenshots and training logs.
ai_sw/car_preview/
ai_sw/selftest.png
*.log
*.err

# Supplied fp04rb source: a 500 MB .blend plus its texture and shadow maps,
# 1.06 GB in all. It is raw input to tools/build_f1_asset.py, which bakes the
# rb_* car -- a fallback the game does not currently use -- and git cannot
# shed a file that size once it is in the history. Keep it out of the repo and
# alongside it instead.
ai_sw/assets/f1_car_model/
# ...and the car it bakes, 19 MB and regenerable from the above.
ai_sw/assets/models/f1/rb_*.bam

# The modelled race car (ai_sw/assets/for+race.blend): its exported parts are
# regenerable by blender/export_race_car.py, and so is the full-detail bake
# (25 MB each). The decimated rl_* bake is what the game ships with.
ai_sw/assets/blender_race/
ai_sw/assets/models/f1/rc_*.bam

# Blender build artefacts: regenerated by blender/*.py.
blender/*.blend
blender/preview*.png
blender/kit_sheet.png
blender/closeup_*.png
blender/*.blend1

# EMNIST source archives (587 MB) -- public data, re-downloadable from
# the NIST/EMNIST distribution. The notebooks in lowercase_letters_extension/
# read these; the trained models next to them are what is worth keeping.
gzip/

# Claude Code's own project notes. Delete this line to version them.
memory/

# Trainer optimiser/replay-buffer state (ai_sw_gpu/train_iqn_gpu.py's
# --state-every dumps), 55 MB each and only useful for resuming the exact
# run that wrote them -- not for deploying or reproducing a result, which
# only needs the *.npz checkpoint next to it. ai_sw/policy/<Circuit>/ has
# dozens of these across abandoned experiments; keep them out of git.
ai_sw/policy/**/*_state.pt

# --- FORMULA-AI release hygiene ------------------------------------------------
# The environment FORMULA-AI.bat creates.
ai_sw/.venv/
# The modelled race car source: 116 MB, over GitHub's 100 MB file limit. The game
# ships its baked results (assets/models/f1/rl_*.bam); rebuild with
# blender/export_race_car.py + ai_sw/tools/build_blender_race.py.
ai_sw/assets/for+race.blend
# Debug plots next to the raceline solutions (the game reads only the .npz).
ai_sw/assets/racelines/*.png
# Iteration screenshots, solver logs and benchmark output.
ai_sw/sim_preview/
ai_sw/holes/
ai_sw/logs/
ai_sw/scene_preview/
# Behaviour-cloning pairs of the rule-based race driver (40 MB, regenerable with
# ai_sw/tools/raceai_collect.py).
ai_sw/policy/raceai/rules_pairs.npz
ai_sw/policy/raceai/ppo_loc2/
ai_sw/policy/raceai/ppo_local/
ai_sw/policy/raceai/bc_w1*
ai_sw/policy/raceai/kg_*/*.log
